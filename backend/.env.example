# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
MONGO_URI=mongodb://localhost:27017/garage_erp

# Authentication (JWT Secret)
JWT_SECRET=your_super_secret_jwt_key_here

# Razorpay Payment Gateway (Test or Live credentials)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Garage Geo-Location & Details
GARAGE_LATITUDE=13.34088
GARAGE_LONGITUDE=74.74214
SERVICE_RADIUS_KM=20
GARAGE_NAME=Garage ERP Auto Services - Udupi
GARAGE_ADDRESS=Near City Bus Stand, Service Bus Stand Road, Udupi, Karnataka 576101
GARAGE_PHONE=+91 98765 43210

# Email / Google SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=vehicleservicegarage@gmail.com
SMTP_PASS=your_google_app_password
FROM_NAME=GarageERP
FROM_EMAIL=vehicleservicegarage@gmail.com

